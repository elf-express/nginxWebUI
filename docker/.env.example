# ============================================
# Nginx Web UI 部署環境設定
# ============================================
# 使用方式：
#   1. 複製此檔案為 .env：cp .env.example .env
#   2. 填入下方金鑰
#   3. 啟動：docker compose up -d
# ============================================

# nginxwebui + nginxwebui-crowdsec image 版本（兩者共用此 tag；留空 = latest）
# → 釘到指定版本：NGINX_WEBUI_VERSION=x.y.z
# → 用 latest 自動跟最新 release（不可重現）：NGINX_WEBUI_VERSION=latest
# → 從原始碼本機 build：docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
NGINX_WEBUI_VERSION=latest

# 要啟用的可選服務（預設只起 nginxwebui + postgres）
# → 安全（CrowdSec：IP 封鎖 + AppSec WAF）：COMPOSE_PROFILES=security，並且「同時」填下面的 CROWDSEC_BOUNCER_KEY
# 留空 = 只起核心。也可改用 `docker compose --profile security up -d`。
# 2026-06-30 起 monitoring profile（Loki/Promtail/Grafana）已移除；
# 舊 .env 留著 COMPOSE_PROFILES=monitoring,security 仍可運作（compose 對未知 profile silently ignore），但建議改回 =security。
COMPOSE_PROFILES=

# CrowdSec Bouncer 金鑰（與上面的 COMPOSE_PROFILES=security 一起設，兩個要同時啟用）
# → 啟用安全防護：COMPOSE_PROFILES=security + 在這裡填金鑰。
# → 沒有要啟用 CrowdSec：留空！只填金鑰、卻沒有啟用 security profile（CrowdSec 沒起來）時，
#   nginx 的 bouncer 連不到 CrowdSec，寬限期（預設 120 秒）過後網站會回 503。
# → 先產生一組隨機金鑰再貼上（crowdsec 容器啟動時會用這組金鑰自動註冊名為 nginx 的 bouncer，不必再手動 cscli bouncers add）：
#     openssl rand -hex 32
# → 要更換金鑰，或從舊的 traefik bouncer 設定升級（已註冊過名為 nginx 的 bouncer）：crowdsec 的資料卷裡已有 nginx，
#   啟動時不會再註冊，新金鑰不會生效。先 `docker exec nginxwebui-crowdsec cscli bouncers delete nginx`，
#   再 `docker compose up -d`；或直接沿用舊金鑰。
# → 不想讓金鑰出現在環境變數：改用 secrets 檔，見 docker-compose.secrets.yml 檔頭（此時這裡留空）。
CROWDSEC_BOUNCER_KEY=

# 初始管理員（選用 — 預設不設，讓首次啟動的 web UI 引導你設密碼）
# 若用於自動化部署需跳過 UI 精靈，取消下兩行註解並填入帳密，並在
# docker-compose.yml 的 BOOT_OPTIONS 加回 --init.admin=${INIT_ADMIN}
# --init.pass=${INIT_PASS} 兩個參數。
# INIT_ADMIN=admin
# INIT_PASS=ChangeThisToAStrongPassword

# nginx 文件 MCP（選用 — 留空 = 不啟用，/mcp 回 404）
# → 填入任意難猜的字串即啟用，例如 `openssl rand -hex 16` 的輸出；不可含空白
# → MCP client 以 Authorization: Bearer <MCP_TOKEN> 連 http://<主機>:12300/mcp
MCP_TOKEN=

# AbuseIPDB API 金鑰
# → 到 https://www.abuseipdb.com 註冊帳號
# → 登入後到 Account → API Keys → Create Key
# → 把金鑰貼到這裡
ABUSEIPDB_API_KEY=your-api-key-here
